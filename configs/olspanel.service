[Unit]
Description=olspanel - panel hostingowy OpenLiteSpeed
After=network-online.target mariadb.service lsws.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/olspanel/bin/olspanel serve
Restart=on-failure
RestartSec=3
Environment=OLSPANEL_DATA_DIR=/var/lib/olspanel
Environment=OLSPANEL_LOG_DIR=/var/log/olspanel
EnvironmentFile=-/etc/olspanel/olspanel.env
User=root
# The daemon manages system accounts (useradd needs lock files in /etc),
# OLS config, crontabs and pure-ftpd, so it runs unconfined as root.
PrivateTmp=no
NoNewPrivileges=no
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
